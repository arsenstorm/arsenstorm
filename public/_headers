# Fonts are versioned by filename, so they can be cached like /_astro/*.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Logos and favicons keep their names, so a week is the ceiling.
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800
# Iframe demo documents are not pages. Markdown twins get noindex from the worker.
/writeup-demos/*
  X-Robots-Tag: noindex
