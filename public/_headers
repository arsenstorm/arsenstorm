# Fonts and icons are versioned by filename, so they can be cached like /_astro/*.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800
/apps/*
  Cache-Control: public, max-age=604800
