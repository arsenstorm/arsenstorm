# Fonts are versioned by filename, so they can be cached like /_astro/*.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Favicons keep their names, so a week is the ceiling.
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800
# Iframe demo documents are not pages. Markdown twins get noindex from the worker.
/writeup-demos/*
  X-Robots-Tag: noindex
# Browsers show these as text instead of downloading an unknown file.
/pgp.asc
  Content-Type: text/plain; charset=utf-8
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
# Web Key Directory. Web mail clients fetch the key cross-origin.
/.well-known/openpgpkey/*
  Access-Control-Allow-Origin: *
# Lets Chrome's private prefetch proxy prefetch pages from Google results.
/.well-known/traffic-advice
  Content-Type: application/trafficadvice+json
