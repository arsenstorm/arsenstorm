# Fonts are versioned by filename, so they can be cached like /_astro/*.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Logos and favicons keep their names, so a week is the ceiling.
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800
# Iframe demo documents and the markdown twins of each page are not pages.
/writeup-demos/*
  X-Robots-Tag: noindex
/*.md
  X-Robots-Tag: noindex
