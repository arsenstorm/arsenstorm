{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arsenstorm",
  "account_id": "8dd0864e5cce87fba700990f062744f0",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "logpush": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Every page goes through the worker so it can answer with markdown on
    // request; static assets that never need it skip the worker.
    "run_worker_first": ["/*", "!/_astro/*", "!/fonts/*", "!/og/*.png"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OGRenderer"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["OGRenderer"]
    }
  ],
  "preview_urls": true,
  "workers_dev": false,
  "secrets": {
    "required": ["GITHUB_TOKEN"]
  },
  "routes": [
    {
      "pattern": "https://arsenstorm.com/*",
      "zone_name": "arsenstorm.com",
      "custom_domain": false
    },
    {
      "pattern": "arsenstorm.com",
      "zone_name": "arsenstorm.com",
      "custom_domain": true
    },
    // Web Key Directory for arsen@shkrumelyak.com. The rest of that zone redirects here.
    {
      "pattern": "openpgpkey.shkrumelyak.com/.well-known/openpgpkey/*",
      "zone_name": "shkrumelyak.com"
    }
  ],
  "triggers": {
    // Refreshes the GitHub contribution stats behind /readme.
    "crons": ["0 */6 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "STATS",
      "id": "447b449e1b474bb89fb21f60906f1c18"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "MARKDOWN_STATS", "dataset": "markdown_requests" }
  ]
}
