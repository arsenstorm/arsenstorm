{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arsenstorm",
  "account_id": "8dd0864e5cce87fba700990f062744f0",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "logpush": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/readme",
      "/readme/preview",
      "/og",
      "/cv.pdf",
      "/",
      "/index.md",
      "/writing",
      "/writing.md",
      "/writing/*",
      "/projects",
      "/projects.md",
      "/experience",
      "/experience.md",
      "/experience/*",
      "/cv",
      "/cv.md",
      "/work",
      "/work.md",
      "/llms.txt"
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OGRenderer"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["OGRenderer"]
    }
  ],
  "preview_urls": true,
  "workers_dev": false,
  "secrets": {
    "required": ["GITHUB_TOKEN"]
  },
  "routes": [
    {
      "pattern": "https://arsenstorm.com/*",
      "zone_name": "arsenstorm.com",
      "custom_domain": false
    },
    {
      "pattern": "arsenstorm.com",
      "zone_name": "arsenstorm.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    // Refreshes the GitHub contribution stats behind /readme.
    "crons": ["0 */6 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "STATS",
      "id": "447b449e1b474bb89fb21f60906f1c18"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "MARKDOWN_STATS", "dataset": "markdown_requests" }
  ]
}
