---
import { CONTACT_METHODS, PGP } from "#/lib/contact";
import { pageLinks, pageMeta } from "#/lib/seo";
import "#/styles.css";

interface Props {
	description: string;
	jsonLd?: string;
	noindex?: boolean;
	path?: string;
	title: string;
	type?: "article" | "website";
}

const { title, description, path = "/", type, jsonLd, noindex } = Astro.props;

const meta = pageMeta(title, description, path, type ? { type } : {});
const links = pageLinks(path);
---

<html lang="en" class="[scrollbar-gutter:stable_both-edges]">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090b" />
		{
			meta.map((entry) =>
				"title" in entry ? (
					<title>{entry.title}</title>
				) : (
					<meta {...entry} />
				)
			)
		}
		{links.map((l) => <link {...l} />)}
		<link
			rel="preload"
			href="/fonts/InterVariable-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link href="/manifest.json" rel="manifest" />
		{CONTACT_METHODS.map((method) => <link href={method.href} rel="me" />)}
		<link href={PGP.href} rel="pgpkey" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Technical Writing | Arsen Shkrumelyak"
			href="/rss.xml"
		/>
		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
		{noindex && <meta name="robots" content="noindex" />}
	</head>
	<body>
		<div class="isolate min-h-dvh bg-white font-sans text-neutral-950 antialiased dark:bg-neutral-950 dark:text-neutral-50">
			<a
				aria-label="Home"
				class="fixed top-6 left-6 z-10 block size-6 rounded-md outline-neutral-950/30 outline-offset-2 transition-opacity after:absolute after:top-1/2 after:left-1/2 after:size-11 after:-translate-x-1/2 after:-translate-y-1/2 hover:opacity-70 focus-visible:outline-2 active:opacity-70 print:hidden dark:outline-white/30"
				href="/"
			>
				<img alt="" class="size-full rounded-md" height="24" src="/apple-touch-icon.png" width="24" />
			</a>
			<slot />
		</div>
	</body>
</html>
