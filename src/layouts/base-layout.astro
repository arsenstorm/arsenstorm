---
import { pageLinks, pageMeta } from "#/lib/seo";
import "#/styles.css";

interface Props {
	description: string;
	jsonLd?: string;
	noindex?: boolean;
	path?: string;
	title: string;
	type?: "article" | "website";
}

const { title, description, path = "/", type, jsonLd, noindex } = Astro.props;

const meta = pageMeta(title, description, path, type ? { type } : {});
const links = pageLinks(path);
---

<html lang="en" class="scrollbar-gutter-stable">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090b" />
		{
			meta.map((entry) =>
				"title" in entry ? (
					<title>{entry.title}</title>
				) : (
					<meta {...entry} />
				)
			)
		}
		{links.map((l) => <link {...l} />)}
		<link
			rel="preload"
			href="/fonts/InterVariable-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link href="/manifest.json" rel="manifest" />
		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
		{noindex && <meta name="robots" content="noindex" />}
	</head>
	<body>
		<div class="isolate min-h-dvh bg-white font-sans text-neutral-950 antialiased dark:bg-neutral-950 dark:text-neutral-50">
			<slot />
		</div>
	</body>
</html>
