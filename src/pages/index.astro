---
import CopyButton from "#/components/copy-button.astro";
import { ExperienceList } from "#/components/experience-list.tsx";
import { ItemGroup } from "#/components/item-group.tsx";
import { Anchor, textLinkClass } from "#/components/link.tsx";
import Main from "#/components/main.astro";
import { PageHeading } from "#/components/page-heading.tsx";
import { Section } from "#/components/section.tsx";
import { Writing } from "#/components/writing.tsx";
import BaseLayout from "#/layouts/base-layout.astro";
import { getExperience } from "#/lib/experience";
import { PROJECTS } from "#/lib/projects.ts";
import { SITE_DESCRIPTION } from "#/lib/seo";
import { getWriteups } from "#/lib/writeups";

const TITLE = "Arsen Shkrumelyak";
const META_DESCRIPTION =
	"Arsen Shkrumelyak builds software with care in London. Software engineer at Better Stack, previously founding engineer at Anyverse. Projects and write-ups.";
const PERSON_JSON_LD = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Person",
	address: {
		"@type": "PostalAddress",
		addressCountry: "GB",
		addressLocality: "London",
	},
	email: "mailto:arsen@shkrumelyak.com",
	jobTitle: "Software Engineer",
	name: TITLE,
	sameAs: [
		"https://www.linkedin.com/in/arsenstorm",
		"https://github.com/arsenstorm",
	],
	url: "https://arsenstorm.com",
	worksFor: {
		"@type": "Organization",
		name: "Better Stack",
		url: "https://betterstack.com",
	},
});

const ELSEWHERE: { label: string; href: string; copy?: string }[] = [
	{ href: "https://www.linkedin.com/in/arsenstorm", label: "LinkedIn" },
	{ href: "https://github.com/arsenstorm", label: "GitHub" },
	{
		copy: "arsen@shkrumelyak.com",
		href: "mailto:arsen@shkrumelyak.com",
		label: "Email",
	},
	{ href: "/contact", label: "Other" },
];

const writeups = await getWriteups();

const experience = (await getExperience()).filter(
	(item) => item.kind === "experience"
);

const featuredProjects = PROJECTS.filter((project) => project.featured);
---

<BaseLayout
	description={META_DESCRIPTION}
	jsonLd={PERSON_JSON_LD}
	title={TITLE}
>
	<Main>
		<PageHeading description={SITE_DESCRIPTION} title={TITLE} />

		<Section
			cta={experience.length > 2
				? { href: "/experience", label: "View all" }
				: undefined}
			title="Experience"
		>
			<ExperienceList items={experience} />
		</Section>

		<Section cta={{ href: "/projects", label: "View all" }} title="Projects">
			<ItemGroup id="projects-list" items={featuredProjects} showAll={false} />
		</Section>

		<Writing items={writeups} />

		<Section title="Elsewhere">
			<ul class="flex flex-col gap-2">
				{ELSEWHERE.map((item) => (
					<li class="group flex items-center gap-0.5 text-sm">
						<Anchor class={textLinkClass} href={item.href}>
							{item.label}
						</Anchor>
						{item.copy ? (
							<CopyButton label={`Copy ${item.copy}`} value={item.copy} />
						) : null}
					</li>
				))}
			</ul>
		</Section>
	</Main>
</BaseLayout>
