---
export const prerender = true;

import { ItemGroup } from "#/components/item-group.tsx";
import Main from "#/components/main.astro";
import { PageHeading } from "#/components/page-heading.tsx";
import { Section } from "#/components/section.tsx";
import BaseLayout from "#/layouts/base-layout.astro";
import { PROJECTS } from "#/lib/projects.ts";

const TITLE = "My Projects";
const DESCRIPTION = "These are the things I've built.";
const META_DESCRIPTION =
	"Projects by Arsen Shkrumelyak: Hookrail (a Rails webhook gateway), Automated Web (self-recording browser automation), OLOS (live streaming on object storage) and more.";
---

<BaseLayout description={META_DESCRIPTION} path="/projects" title={TITLE}>
  <Main>
    <PageHeading description={DESCRIPTION} title={TITLE} />

    <Section cta={{ label: "Go back", href: "/" }} title="Projects">
      <ItemGroup id="projects-list" items={PROJECTS} />
    </Section>
  </Main>
</BaseLayout>
